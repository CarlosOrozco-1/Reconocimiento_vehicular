{
  "info": {
    "name": "Traffic Map Guatemala API",
    "_postman_id": "7a8b2f8d-7b4a-4d3b-9d7e-traffic-map-api",
    "description": "Collection base para pruebas de endpoints del backend geoespacial.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Routes Main",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/routes/main?limit=500",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "routes",
            "main"
          ],
          "query": [
            {
              "key": "limit",
              "value": "500"
            }
          ]
        }
      }
    },
    {
      "name": "Peak Hours",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/peak-hours",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "peak-hours"
          ]
        }
      }
    },
    {
      "name": "Peak Hours By Date Range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/peak-hours?from_date=2026-01-01&to_date=2026-12-31",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "peak-hours"
          ],
          "query": [
            {
              "key": "from_date",
              "value": "2026-01-01"
            },
            {
              "key": "to_date",
              "value": "2026-12-31"
            }
          ]
        }
      }
    },
    {
      "name": "Departments",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/departments?limit=500",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "departments"
          ],
          "query": [
            {
              "key": "limit",
              "value": "500"
            }
          ]
        }
      }
    },
    {
      "name": "Route Departments",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/routes/CA-1/departments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "routes",
            "CA-1",
            "departments"
          ]
        }
      }
    }
  ]
}
