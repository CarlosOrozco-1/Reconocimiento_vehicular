{
    auto_https disable_redirects
}

{$SITE_HOST} {
    tls internal
    encode zstd gzip

    # Proxy /api/* → backend (strip el prefijo /api antes de reenviar)
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy traffic_gt_backend:8000
    }

    # Todo lo demas → frontend Angular (SPA)
    handle {
        reverse_proxy traffic_gt_frontend:80
    }
}
